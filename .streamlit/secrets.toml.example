# Copia esto en Streamlit Cloud: App -> Settings -> Secrets (NO subas el secrets.toml real a GitHub)
# Servidor TURN gratuito: crea una cuenta en https://www.metered.ca/tools/openrelay/ (o usa Twilio)

[[ice_servers]]
urls = ["stun:stun.l.google.com:19302"]

[[ice_servers]]
urls = ["turn:TU_SERVIDOR_TURN:80", "turn:TU_SERVIDOR_TURN:443?transport=tcp"]
username = "TU_USUARIO"
credential = "TU_CONTRASEÑA"
